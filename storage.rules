rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function autenticado() {
      return request.auth != null;
    }

    // Lectura pública de imágenes de galería; escritura solo autenticados
    // (el admin se valida en la app + Firestore). Ajusta si necesitas solo admin.
    match /galeria/{fileName} {
      allow read: if true;
      allow write: if autenticado()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if autenticado();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
